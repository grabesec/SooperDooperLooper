# SDL for the manual QA lab: this checkout, installed, plus the lab's helper.
FROM python:3.12-slim
WORKDIR /src
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN pip install --no-cache-dir --root-user-action=ignore ".[ldap]"
COPY lab/labctl.py /opt/lab/labctl.py
ENV SDL_URL=http://127.0.0.1:8800
EXPOSE 8800
CMD ["python", "-u", "/opt/lab/labctl.py", "serve"]
